    },
    {
      "id": "11",
      "start": 51,
      "end": 56,
      "text": "Then enter the password. These values will not be saved.",
      "raw_seconds": 3.575875,
      "trimmed_seconds": 3.411479,
      "tempo": 1.0,
      "audio_start": 51.15,
      "audio_end": 54.561479,
      "source_audio_sha256": "943c7f2e1ddc26cffc2a3cbbf5c8d76ef513975fd1027512d5838deba49f917d"
    },
    {
      "id": "12",
      "start": 56,
      "end": 63,
      "text": "Review the website and requested fields, then choose Use once. You control this approval.",
      "raw_seconds": 6.048813,
      "trimmed_seconds": 5.906,
      "tempo": 1.0,
      "audio_start": 56.15,
      "audio_end": 62.056,
