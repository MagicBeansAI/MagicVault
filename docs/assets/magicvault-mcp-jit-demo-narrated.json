  "segments": [
    {
      "id": "01",
      "start": 0,
      "end": 7,
      "text": "Magic Vault lets Codex log in with just-in-time credentials. First, enable M C P.",
      "raw_seconds": 6.954406,
      "trimmed_seconds": 6.664917,
      "tempo": 1.0022431578947368,
      "audio_start": 0.15,
      "audio_end": 6.800000000000001,
      "source_audio_sha256": "10ab570741afb6c9dde8c40e084de15b72e7ac202ad4cb1189cb00196ec703a9"
    },
    {
      "id": "02",
      "start": 7,
      "end": 11,
      "text": "Approve pairing in Magic Vault's private window.",
      "raw_seconds": 2.809625,
      "trimmed_seconds": 2.527917,
      "tempo": 1.0,
      "audio_start": 7.15,
      "audio_end": 9.677917,
      "source_audio_sha256": "d011b4f2fab347ba2e6e976277e8a6f9404f51cfbc50796aa3d5a804c166599e"
    },
    {
      "id": "03",
      "start": 11,
      "end": 17,
      "text": "Saving is optional. Here, we save a login for repeat tasks.",
      "raw_seconds": 4.260875,
      "trimmed_seconds": 4.078875,
      "tempo": 1.0,
      "audio_start": 11.15,
      "audio_end": 15.228875,
      "source_audio_sha256": "33f34ef2cdc60a944e31b2e24d4b05c719da23267f2a6e79a912a0e56ce0d8b6"
    },
    {
      "id": "04",
      "start": 17,
      "end": 21,
      "text": "Enter the password in the private window.",
      "raw_seconds": 2.171094,
      "trimmed_seconds": 1.977729,
      "tempo": 1.0,
      "audio_start": 17.15,
      "audio_end": 19.127729,
      "source_audio_sha256": "fab19b6beb9923a5499d0255a7d7a7d958d6f556621953fd21db1da83889dea9"
    },
    {
      "id": "05",
      "start": 21,
      "end": 25,
      "text": "You can also store card fields, shown with synthetic data.",
      "raw_seconds": 4.179594,
      "trimmed_seconds": 3.888292,
      "tempo": 1.0652854794520548,
      "audio_start": 21.15,
      "audio_end": 24.799999999999997,
      "source_audio_sha256": "0ca7556566b5fa21d4e867286b4b9a2fccaa625b2f6b37c315720d8f6f372e0b"
    },
    {
      "id": "06",
      "start": 25,
      "end": 29,
      "text": "The agent sees references and field names, never values.",
      "raw_seconds": 3.87775,
      "trimmed_seconds": 3.716729,
      "tempo": 1.0182819178082192,
      "audio_start": 25.15,
      "audio_end": 28.799999999999997,
      "source_audio_sha256": "74fb7cbdcbd6ac5b35c0d4b1c2f4a05a32c3d1fe7fb0e1964ab1bf19875bd888"
    },
    {
      "id": "07",
      "start": 29,
      "end": 32,
      "text": "Approve the browser connection.",
      "raw_seconds": 1.834406,
      "trimmed_seconds": 1.579542,
      "tempo": 1.0,
      "audio_start": 29.15,
      "audio_end": 30.729542,
      "source_audio_sha256": "0b05eb98b1fc74d4b641aa5456856f38f75e26ae929905d7132d715724d78ba2"
    },
    {
      "id": "08",
      "start": 32,
      "end": 41,
      "text": "Now, the actual login uses just-in-time input. No saved login is needed. We ask this real Codex session to begin.",
      "raw_seconds": 8.440469,
      "trimmed_seconds": 8.17325,
      "tempo": 1.0,
      "audio_start": 32.15,
      "audio_end": 40.32325,
      "source_audio_sha256": "3454ae742f7f39ca56c50ebf2d5105db0709e712f7c3ddee0963acf059bd98f6"
    },
    {
      "id": "09",
      "start": 41,
      "end": 46,
      "text": "Codex requests a one-time fill using destination metadata.",
      "raw_seconds": 4.260875,
      "trimmed_seconds": 4.080125,
      "tempo": 1.0,
      "audio_start": 41.15,
      "audio_end": 45.230125,
      "source_audio_sha256": "ee9ea2c0bb81c0fd89b18ba0edb3665cce41d86169fd2cce8facbb1dea770d80"
    },
    {
      "id": "10",
      "start": 46,
      "end": 51,
      "text": "Enter the username directly in Magic Vault's private window.",
      "raw_seconds": 3.366906,
      "trimmed_seconds": 3.090313,
      "tempo": 1.0,
      "audio_start": 46.15,
