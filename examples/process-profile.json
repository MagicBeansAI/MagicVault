{
  "label": "Example trusted command",
  "destination": {
    "kind": "process",
    "config": {
      "executable": "/absolute/path/to/trusted-recipient",
      "arguments": [],
      "working_directory": "/absolute/path/to/trusted-work-directory",
      "environment": [{
        "name": "SERVICE_TOKEN",
